# Copy to .env and supply your own MongoDB read-only connection URI.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGO_DB=mcp_group_lab
MONGO_COLLECTION=shipwrecks
REDIS_URL=redis://127.0.0.1:16380/0
REDIS_ALLOWED_KEYS=shipwreck_summary,water_level_counts
MONGO_API_URL=http://127.0.0.1:5001
REDIS_API_URL=http://127.0.0.1:5002
MCP_URL=http://127.0.0.1:5000/mcp
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
